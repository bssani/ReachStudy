# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Per-PC overrides (engine reads Config/User*.ini last and never writes it). Home test switches such as
# go here so they never reach another PC
Config/User*.ini

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Meta XR 1.205.0 and Meta Interaction SDK 1.205.0 are NOT committed: this repo is public and parts of
# both plugins are under the Oculus SDK License. Copy them from Fab or a private checkout into Plugins/
# before building (README "Setup").
Plugins/MetaXR/
Plugins/MetaXRInteraction/
Plugins/OculusInteractionSamples/

# Vehicle CAD is confidential and never goes to this public repo. Keep imported CAD under Content/CAD/.
Content/CAD/
*.jt
*.CATPart
*.CATProduct
*.stp
*.step
*.udatasmith

# Claude (spec/review) <-> Codex app (implementation) handoff. Volatile; durable records are Docs/Specs, Docs/Reviews.
/HANDOFF.md

# Local dev tooling
Plugins/UnrealAgent/
Plugins/McpAutomationBridge/
.unrealagent/
.codex/config.toml
